print(f"Search 'BIOL 101': index {search_value(search_courses, 'BIOL 101')}")


print("\n=== EDGE CASES ===")

empty = []

# Delete from an empty list
print("Delete from empty:", delete_at(empty, 0))

# Search in an empty list
print("Search empty:", search_value(empty, "CMSC 315"))

# Insert into an empty list
insert_at(empty, 0, "CMSC 315")
print("Insert into empty:", empty)

# Invalid indexes
print("Negative index rejected:", delete_at(empty, -1), empty)
print("Index equal to length rejected:", delete_at(empty, len(empty)), empty)

# Delete the only item
print("Delete only item:", delete_at(empty, 0), empty)


print("\n=== STUDENT COURSE SCENARIO ===")

# Real-world example: managing a student's course schedule
schedule = ["CMSC 315", "CMSC 350", "MATH 115"]

# Add a new course
insert_at(schedule, 0, "CMIS 141")
print("Added a new course:", schedule)

# Find and remove a course
index = search_value(schedule, "CMSC 350")

if index != -1:
    print("Dropped course:", delete_at(schedule, index))

print("Updated schedule:", schedule)
