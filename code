print("\n=== INSERTION TESTS ===")

# Create a list of courses
courses = ["CMSC 315", "CMSC 350", "MATH 115"]
print("Original courses:", courses)

# Insert a course at the beginning
insert_at(courses, 0, "CMIS 141")
print("Beginning:", courses)

# Insert a course in the middle
insert_at(courses, len(courses) // 2, "STAT 200")
print("Middle:", courses)

# Insert a course at the end
insert_at(courses, len(courses), "IFSM 300")
print("End:", courses)


print("\n=== DELETION TESTS ===")

# Delete from the beginning
removed = delete_at(courses, 0)
print(f"Beginning: removed {removed}; remaining: {courses}")

# Delete from the middle
removed = delete_at(courses, len(courses) // 2)
print(f"Middle: removed {removed}; remaining: {courses}")

# Delete from the end
removed = delete_at(courses, len(courses) - 1)
print(f"End: removed {removed}; remaining: {courses}")


print("\n=== SEARCH TESTS ===")

search_courses = ["CMSC 315", "CMSC 350", "MATH 115"]

